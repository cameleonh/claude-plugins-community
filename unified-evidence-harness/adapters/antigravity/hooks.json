{
  "unified-evidence-harness": {
    "enabled": true,
    "PreToolUse": [{"matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command", "hooks": [{"type": "command", "command": "python scripts/hook_adapter.py --platform antigravity --event pre-tool", "timeout": 10}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python scripts/hook_adapter.py --platform antigravity --event post-tool", "timeout": 15}]}],
    "PreInvocation": [{"type": "command", "command": "python scripts/hook_adapter.py --platform antigravity --event pre-invocation", "timeout": 10}],
    "Stop": [{"type": "command", "command": "python scripts/hook_adapter.py --platform antigravity --event stop", "timeout": 20}]
  }
}

