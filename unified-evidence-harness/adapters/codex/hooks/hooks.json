{
  "description": "Unified Evidence Harness v4 for Codex",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event session-start", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event user-prompt", "timeout": 10}]}],
    "PreToolUse": [{"matcher": "Write|Edit|MultiEdit|Bash|apply_patch|exec_command", "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event pre-tool", "timeout": 10}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event post-tool", "timeout": 15}]}],
    "PostToolUseFailure": [{"matcher": "*", "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event post-tool-failure", "timeout": 10}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event pre-compact", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_adapter.py\" --platform codex --event stop", "timeout": 20}]}]
  }
}

